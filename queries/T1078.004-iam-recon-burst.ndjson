{"id":"a76eed74-24d8-4f67-a6da-eb2026a77449","updated_at":"2026-07-13T07:43:11.401Z","updated_by":"siem","created_at":"2026-07-13T07:43:11.401Z","created_by":"siem","name":"T1078.004 — IAM Reconnaissance Burst","tags":[],"interval":"5m","enabled":true,"revision":0,"description":"Detects bursts of AWS IAM reconnaissance activity, such as listing users, roles, policies, or account details. These actions often precede privilege escalation or lateral movement attempts, as attackers or unauthorized users try to map IAM configurations and identify exploitable permissions.","risk_score":47,"severity":"medium","license":"","output_index":"","meta":{"kibana_siem_app_url":"http://192.168.31.130:5601/app/security"},"author":[],"false_positives":[],"from":"now-6m","rule_id":"a30e6327-b0ac-4d5b-8f3e-4ddce5ea76d5","max_signals":100,"risk_score_mapping":[],"severity_mapping":[],"threat":[{"framework":"MITRE ATT&CK","tactic":{"id":"TA0001","name":"Initial Access","reference":"https://attack.mitre.org/tactics/TA0001/"},"technique":[{"id":"T1078","name":"Valid Accounts","reference":"https://attack.mitre.org/techniques/T1078/","subtechnique":[]}]}],"to":"now","references":[],"version":1,"exceptions_list":[],"immutable":false,"rule_source":{"type":"internal"},"related_integrations":[],"required_fields":[],"setup":"","type":"query","language":"kuery","index":["apm-*-transaction*","auditbeat-*","endgame-*","filebeat-*","logs-*","packetbeat-*","traces-apm*","winlogbeat-*","-*elastic-cloud-logs-*"],"query":"event.dataset: \"aws.cloudtrail\" AND\nevent.provider: (\"iam.amazonaws.com\" OR \"sts.amazonaws.com\") AND\nevent.action: (\n  \"ListUsers\" OR \"ListRoles\" OR \"ListAttachedUserPolicies\" OR\n  \"ListPolicies\" OR \"GetAccountSummary\" OR \"GetCallerIdentity\"\n) AND\nNOT aws.cloudtrail.user_identity.arn: \"*elastic-cloudtrail-reader*\"","filters":[],"actions":[]}
